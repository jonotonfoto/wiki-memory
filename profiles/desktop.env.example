# Desktop profile (Windows) — copy to desktop.env and adjust
WIKI_PATH=%LOCALAPPDATA%\hermes\wiki
WIKI_EMBED_BACKEND=llamaserver
# llama.cpp embedding server
WIKI_EMBED_URL=http://127.0.0.1:11435/v1/embeddings
WIKI_EMBED_MODEL=Qwen3-Embedding-0.6B-Q8_0
# chat LLM used by extraction (OpenAI-compatible endpoint)
NVIDIA_CHAT_MODEL=gpt-oss-20b
# dashboard on/off (1/0)
WIKI_DASHBOARD=1
