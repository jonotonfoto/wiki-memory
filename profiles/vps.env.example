# VPS profile (Linux / Docker container) — copy to vps.env and adjust
WIKI_PATH=/opt/data/wiki
WIKI_EMBED_BACKEND=<your-vps-backend>
WIKI_EMBED_URL=http://127.0.0.1:<port>/v1/embeddings
WIKI_EMBED_MODEL=<quantized-model-name>
NVIDIA_CHAT_MODEL=<chat-model-available-on-vps>
# dashboard off on small boxes (RAM)
WIKI_DASHBOARD=0
