# VPS profile (Linux / Docker container) — copy to vps.env and adjust
WIKI_PATH=/opt/data/wiki
# Embeddings endpoint. Inside a Docker container, host ports are reachable
# ONLY via the docker bridge gateway IP — 127.0.0.1 will NOT work:
WIKI_EMBED_BACKEND=<your-vps-backend>
WIKI_EMBED_URL=http://172.20.0.1:<port>/v1/embeddings
WIKI_EMBED_MODEL=<quantized-model-name>
NVIDIA_CHAT_MODEL=<chat-model-available-on-vps>
# dashboard off on small boxes (RAM)
WIKI_DASHBOARD=0

# LLM-call budget per session run (summary/facts + chunk tags). Default 6
# fits free-tier NVIDIA NIM without 429-blocking; raise on paid APIs or
# long sessions get their MAP stage truncated mid-way.
WIKI_EXTRACT_MAX_LLM_CALLS=12

# Chunk texts per embeddings HTTP request (indexer.embed_chunks). Default 8
# is proven safe together with the hardened llama-server flags from
# deploy/vps/ (see README there); lower it further on very small boxes.
WIKI_EMBED_SUBBATCH=8
