# ===========================================================================
# .env.example — Wiki Memory configuration template
# Copy to your Hermes .env (or a local .env next to scripts) and fill in.
# All values are OPTIONAL — the system falls back to OS-appropriate defaults.
# ===========================================================================

# --- Required for indexing/search ------------------------------------------
# NVIDIA API key for the LLM (Nemotron) used for extraction and embeddings.
# Get one at https://build.nvidia.com (free tier available).
NVIDIA_API_KEY=

# --- Optional overrides (defaults are auto-detected per OS) ---------------
# Where Hermes stores its data (sessions DB, wiki).
#   Windows default: %LOCALAPPDATA%\hermes
#   Linux/VPS/container default: /opt/data  (fallback ~/.hermes)
#HERMES_HOME=

# Path to the wiki data dir (entities/, .index_v2.db).
#   Default: <HERMES_HOME>/wiki
#WIKI_PATH=

# Path to Hermes sessions DB (state.db).
#   Default: <HERMES_HOME>/state.db
#HERMES_STATE_DB=

# Python interpreter used to run the indexer/sweep subprocesses.
#   Default: auto-detected (Windows: current venv; Linux: .venv-wiki)
#WIKI_PYTHON=

# NVIDIA endpoint / model overrides (only if you need non-default values).
#NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
#NVIDIA_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings
#NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
#NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# --- Behavioral knobs ------------------------------------------------------
# How many minutes without messages before a session counts as "finished".
#   Default: 32
#WIKI_IDLE_MINUTES=32

# Max age (seconds) of a stale index lock before it is reclaimed.
#   Default: 900 (15 min) — must be < your sweep interval.
#WIKI_LOCK_MAX_AGE=900
